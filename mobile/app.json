{
  "expo": {
    "name": "Youth KGU",
    "slug": "youth-kgu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1c6681"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "vn.kgu.youth",
      "infoPlist": {
        "NSCameraUsageDescription": "Cần camera để quét mã QR điểm danh hoạt động."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1c6681"
      },
      "package": "vn.kgu.youth",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "apiBaseUrl": "http://100.110.62.27:32156"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Youth KGU truy cập camera để quét mã QR điểm danh."
        }
      ],
      "expo-image",
      "expo-status-bar"
    ]
  }
}
